DATABASE_URL="postgresql://tbbapp:tbbapp_dev_password@localhost:5433/tbbapp"
PORT=3000
NODE_ENV=development
# Admin endpoint'leri (GET/PATCH /feedback, /new-place-requests) x-admin-key header'ında bunu bekler.
ADMIN_API_KEY="change-me-to-a-random-secret"
# Kullanıcı (vatandaş) JWT oturumlarını imzalamak için kullanılır.
JWT_SECRET="change-me-to-a-random-secret"
# Şifre sıfırlama kodlarını göndermek için (resend.com, ücretsiz plan). Tanımlı değilse
# kod gerçek email yerine sunucu konsoluna yazılır (yerel geliştirme için yeterli).
RESEND_API_KEY=""
# Doğrulanmış bir domain'in yoksa Resend'in test gönderen adresini kullan.
MAIL_FROM="Tekirdağ Büyükşehir Belediyesi <onboarding@resend.dev>"
