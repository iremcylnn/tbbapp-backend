// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  firstName String   @map("ad")
  lastName  String   @map("soyad")
  email     String   @unique
  password  String   @map("sifre")
  createdAt DateTime @default(now()) @map("olusturulma_tarihi")

  feedbackSubmissions FeedbackSubmission[]
  newPlaceSubmissions NewPlaceSubmission[]
  passwordResetCodes  PasswordResetCode[]

  @@map("kullanicilar")
}

model PasswordResetCode {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("kullanici_id")
  codeHash  String    @map("kod_hash")
  expiresAt DateTime  @map("son_kullanma_tarihi")
  usedAt    DateTime? @map("kullanilma_tarihi")
  createdAt DateTime  @default(now()) @map("olusturulma_tarihi")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("sifre_sifirlama_kodlari")
}

model District {
  id     Int     @id @default(autoincrement())
  name   String  @map("ilce")
  places Place[]

  @@map("ilceler")
}

model Category {
  id     Int     @id @default(autoincrement())
  title  String  @map("baslik")
  order  Int     @map("sira")
  places Place[]

  @@map("harita_filtre")
}

model Place {
  id          Int     @id @default(autoincrement())
  districtId  Int     @map("ilce_id")
  categoryId  Int     @map("harita_filtre_id")
  name        String  @map("konum_adi")
  latitude    Float   @map("enlem")
  longitude   Float   @map("boylam")
  description String? @map("aciklama")

  district District @relation(fields: [districtId], references: [id])
  category Category @relation(fields: [categoryId], references: [id])

  @@map("koordinatlar")
}

enum FeedbackKind {
  complaint
  request

  @@map("sikayet_talep_turu")
}

model FeedbackSubmission {
  id          Int          @id @default(autoincrement())
  userId      Int          @map("kullanici_id")
  kind        FeedbackKind
  description String
  placeId     Int?         @map("koordinat_id")
  latitude    Float?       @map("enlem")
  longitude   Float?       @map("boylam")
  createdAt   DateTime     @default(now()) @map("olusturulma_tarihi")

  user User @relation(fields: [userId], references: [id])

  @@index([kind])
  @@index([createdAt])
  @@map("sikayet_talepler")
}

enum NewPlaceStatus {
  pending
  approved
  rejected

  @@map("yeni_yer_talep_durumu")
}

model NewPlaceSubmission {
  id          Int            @id @default(autoincrement())
  userId      Int            @map("kullanici_id")
  name        String         @map("konum_adi")
  categoryId  Int?           @map("harita_filtre_id")
  description String
  latitude    Float          @map("enlem")
  longitude   Float          @map("boylam")
  status      NewPlaceStatus @default(pending)
  createdAt   DateTime       @default(now()) @map("olusturulma_tarihi")

  user User @relation(fields: [userId], references: [id])

  @@index([status])
  @@index([createdAt])
  @@map("yeni_yer_talepleri")
}
